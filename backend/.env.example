# API Configuration
API_BASE_URL=http://localhost:8000
APP_NAME=AI Quiz Backend
APP_VERSION=1.0.0
DEBUG=true

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.4

# Logging
LOG_LEVEL=INFO

# Web Search / Retrieval Configuration
# Tavily powers the grounded quiz agent. Without TAVILY_API_KEY the app
# automatically degrades to pure-model quiz generation (marked 未经联网核实).
TAVILY_API_KEY=your_tavily_api_key_here
SEARCH_ENABLED=true
AGENT_RECURSION_LIMIT=8
AGENT_TIMEOUT_SECONDS=60
TAVILY_MAX_RESULTS=6

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=ai_learn

# WeChat Login Configuration
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here

# Avatar Upload Configuration
# Uploaded images are stored under AVATAR_UPLOAD_DIR and served at
# {API_BASE_URL}/static/avatars/...; API_BASE_URL must be reachable by the mini program.
AVATAR_UPLOAD_DIR=uploads/avatars
AVATAR_MAX_SIZE_MB=5

# JWT Configuration
JWT_SECRET_KEY=replace_with_a_high_entropy_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
